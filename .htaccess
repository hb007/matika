Options -Indexes
DirectoryIndex index.php

# /holka, /kluk (sešity ze starší verze) a /u/<přezdívka>: stránka s profilem
# dítěte (bez lomítka na konci; relativní cesty řeší <base> v index.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(holka|kluk)$ index.php [L]
    RewriteRule ^u/[a-z0-9-]+$ index.php [L]
    RewriteRule ^admin$ admin.php [L]
    # heslo správce (basic auth) i pod CGI/FastCGI, kde PHP hlavičku Authorization jinak nevidí
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
